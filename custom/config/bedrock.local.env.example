# =============================================================================
# AWS Bedrock Local Configuration Template
# =============================================================================
# Copy this file to `custom/config/bedrock.local.env` and populate your AWS
# credentials. This file is git-ignored and automatically restored into the
# database during `bin/setup_dev.sh` and `rails custom:seed`.
# =============================================================================

CAPTAIN_LLM_PROVIDER=bedrock
CAPTAIN_BEDROCK_REGION=us-east-1
CAPTAIN_BEDROCK_ACCESS_KEY_ID=
CAPTAIN_BEDROCK_SECRET_ACCESS_KEY=
CAPTAIN_BEDROCK_SESSION_TOKEN=
